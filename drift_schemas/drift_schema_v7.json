  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "note_groups",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_groups\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"parent_id\" TEXT NULL REFERENCES note_groups (id) ON DELETE SET NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NULL, \"position\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"original_text\" TEXT NOT NULL, \"extracted_text\" TEXT NULL, \"edited_text\" TEXT NULL, \"proposed_text\" TEXT NULL, \"source\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"rewrite\" TEXT NOT NULL DEFAULT 'none', \"attachment_path\" TEXT NULL, \"attachment_name\" TEXT NULL, \"attachment_bytes\" INTEGER NULL, \"voice_path\" TEXT NULL, \"duration_ms\" INTEGER NULL, \"image_paths\" TEXT NOT NULL DEFAULT '', \"concepts\" TEXT NOT NULL DEFAULT '', \"cluster\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"group_id\" TEXT NULL REFERENCES note_groups (id) ON DELETE SET NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "note_attachments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_attachments\" (\"id\" TEXT NOT NULL, \"note_id\" TEXT NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"kind\" TEXT NOT NULL, \"path\" TEXT NOT NULL, \"name\" TEXT NULL, \"bytes\" INTEGER NULL, \"duration_ms\" INTEGER NULL, \"position\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL, \"transcript\" TEXT NULL, \"transcript_note_text\" TEXT NULL, \"transcription_order\" INTEGER NULL, \"transcription_status\" TEXT NOT NULL DEFAULT 'none', \"transcription_failure\" TEXT NULL, \"transcription_engine\" TEXT NULL, \"transcribed_at\" INTEGER NULL, \"transcription_attempts\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "note_links",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"note_links\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"source_id\" TEXT NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"target_id\" TEXT NOT NULL REFERENCES notes (id) ON DELETE CASCADE, \"label\" TEXT NOT NULL, \"strength\" REAL NOT NULL, \"origin\" TEXT NOT NULL DEFAULT 'ai', \"dismissed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"dismissed\" IN (0, 1)), \"created_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "chat_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"chat_entries\" (\"id\" TEXT NOT NULL, \"project_id\" TEXT NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"role\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"source_ids\" TEXT NOT NULL DEFAULT '', \"found\" INTEGER NOT NULL DEFAULT 1 CHECK (\"found\" IN (0, 1)), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
